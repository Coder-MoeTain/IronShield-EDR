## IronShield EDR (enterprise)
## Copy to .env and set ALL values.

# Server
PORT=3000
NODE_ENV=production
TRUST_PROXY=true
ENFORCE_TLS_IN_PRODUCTION=true
ENFORCE_AGENT_MTLS_IN_PRODUCTION=true

# TLS / mTLS
TLS_ENABLED=true
TLS_KEY_PATH=
TLS_CERT_PATH=
TLS_CA_PATH=
AGENT_MTLS_REQUIRED=true

# CORS (comma-separated allowlist)
CORS_ORIGINS=https://edr.example.com

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=edr_user
DB_PASSWORD=replace-me
DB_NAME=edr_platform

# Auth (production: JWT_SECRET >= 32 chars, not a known weak value; METRICS_TOKEN required if metrics enabled)
JWT_SECRET=replace-me-with-a-strong-secret
# Break-glass only when CONFIG_SKIP_PRODUCTION_SECRET_CHECK=true for emergency bootstrap
# CONFIG_SKIP_PRODUCTION_SECRET_CHECK=false
# Optional: during JWT_SECRET rotation, still verify tokens signed with the old key
JWT_SECRET_PREVIOUS=
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d
AUTH_MAX_FAILED_LOGINS=5
AUTH_LOCK_MINUTES=15
AUTH_ENFORCE_MFA_ALL_ADMINS=true
AUTH_REQUIRE_MFA_LOCAL_LOGIN=true
# session invalidation on-demand (JWT includes session_version)

# SSO federation
OIDC_ENABLED=false
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
OIDC_SCOPE=openid profile email
OIDC_ACR_VALUES=

# SAML proxy-mode federation (through trusted reverse proxy / IdP gateway)
SAML_ENABLED=false
SAML_TRUSTED_PROXY_SECRET=
SAML_TRUSTED_HEADER_USER=x-sso-user
SAML_TRUSTED_HEADER_EMAIL=x-sso-email
SAML_TRUSTED_HEADER_NAMEID=x-sso-nameid

# Agent enrollment
AGENT_REGISTRATION_TOKEN=replace-me-with-a-strong-token
# Agent request signing (HMAC over method/path/timestamp/nonce/body-hash)
AGENT_REQUEST_SIGNING_REQUIRED=false
AGENT_REQUEST_SIGNING_MAX_SKEW_SECONDS=300
# Server-side pepper for agent_key_hash (required in production, >= 16 chars)
AGENT_KEY_PEPPER=replace-me-with-random-pepper-32chars
# Nonce store: redis (preferred), mysql, or memory (single-node dev only)
AGENT_NONCE_STORE=redis
AGENT_NONCE_GC_INTERVAL_MS=900000
# Telemetry storage backend: mysql (default), opensearch, clickhouse (placeholders delegate to mysql)
EVENT_STORE=mysql
# Real Time Response — disabled by default; enable per tenant + endpoint
RTR_ENABLED=false
RTR_SESSION_TIMEOUT_MINUTES=30
RTR_COMMAND_TIMEOUT_SECONDS=120
RTR_MAX_OUTPUT_BYTES=65536
INGEST_QUEUE_FIRST=true
RESPONSE_COMMAND_HMAC_KEY=

# Response approvals / SoD hardening
RESPONSE_APPROVAL_REQUIRE_JUSTIFICATION_FOR_HIGH_RISK=true
RESPONSE_APPROVAL_MIN_JUSTIFICATION_LENGTH=8

# XDR ingest (3rd party sources)
XDR_INGEST_KEY=replace-me-with-a-strong-ingest-key

# Metrics (optional; if METRICS_TOKEN is set, /metrics requires it)
METRICS_ENABLED=true
METRICS_TOKEN=
# When enabled, /metrics includes ironshield_soc_* gauges (same snapshot as /api/admin/soc/readiness)

# Kafka (optional)
KAFKA_ENABLED=false
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=ironshield-edr
KAFKA_GROUP_ID=ironshield-workers

# SIEM export reliability (optional)
SIEM_NDJSON_PATH=
SIEM_WEBHOOK_URL=
SIEM_WEBHOOK_SECRET=
SIEM_FAILED_NDJSON_PATH=

# Optional immutable audit archive (append-only NDJSON on hardened storage)
AUDIT_ARCHIVE_PATH=
AUDIT_ARCHIVE_HMAC_KEY=
# NDJSON spill when DB audit insert fails (default: server-node/artifacts/audit-failures.ndjson)
AUDIT_FAILURE_LOG_PATH=

# Ingest idempotency retention
AGENT_EVENT_IDEMPOTENCY_RETENTION_DAYS=7

# Async event processing (optional — enables BullMQ worker: npm run worker)
REDIS_URL=redis://127.0.0.1:6379

