{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ironshield.local/schemas/detection-test.json",
  "title": "IronShield Detection Test Case",
  "type": "object",
  "required": ["id", "description", "events", "expected_alerts"],
  "properties": {
    "id": { "type": "string" },
    "description": { "type": "string" },
    "events": { "type": "array", "minItems": 1 },
    "expected_alerts": { "type": "array" },
    "expected_no_alerts": { "type": "boolean" }
  }
}
