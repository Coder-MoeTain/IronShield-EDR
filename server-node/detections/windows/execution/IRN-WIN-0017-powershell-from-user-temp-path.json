{
  "id": "IRN-WIN-0017",
  "name": "PowerShell from User Temp Path",
  "description": "PowerShell from User Temp Path (defensive detection).",
  "status": "stable",
  "severity": "high",
  "risk_score": 72,
  "platform": "windows",
  "event_types": [
    "process_create"
  ],
  "mitre": {
    "tactics": [
      "Execution"
    ],
    "techniques": [
      "T1059.001"
    ]
  },
  "logic": {
    "all": [
      {
        "field": "process_name",
        "op": "contains",
        "value": "powershell.exe"
      },
      {
        "field": "command_line",
        "op": "contains",
        "value": "\\temp\\"
      }
    ]
  },
  "author": "IronShield",
  "version": "1.0.0"
}
