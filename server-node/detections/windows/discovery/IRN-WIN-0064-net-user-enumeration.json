{
  "id": "IRN-WIN-0064",
  "name": "Net User Enumeration",
  "description": "Net User Enumeration (defensive detection).",
  "status": "stable",
  "severity": "medium",
  "risk_score": 48,
  "platform": "windows",
  "event_types": [
    "process_create"
  ],
  "mitre": {
    "tactics": [
      "Discovery"
    ],
    "techniques": [
      "T1087.001"
    ]
  },
  "logic": {
    "all": [
      {
        "field": "process_name",
        "op": "contains",
        "value": "net.exe"
      },
      {
        "field": "command_line",
        "op": "contains",
        "value": " user"
      }
    ]
  },
