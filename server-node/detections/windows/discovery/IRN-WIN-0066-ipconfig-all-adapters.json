{
  "id": "IRN-WIN-0066",
  "name": "Ipconfig All Adapters",
  "description": "Ipconfig All Adapters (defensive detection).",
  "status": "stable",
  "severity": "low",
  "risk_score": 32,
  "platform": "windows",
  "event_types": [
    "process_create"
  ],
  "mitre": {
    "tactics": [
      "Discovery"
    ],
    "techniques": [
      "T1016"
    ]
  },
  "logic": {
    "all": [
      {
        "field": "process_name",
        "op": "contains",
        "value": "ipconfig.exe"
      },
      {
        "field": "command_line",
        "op": "contains",
        "value": "/all"
      }
    ]
  },
  "author": "IronShield",
  "version": "1.0.0"
}
