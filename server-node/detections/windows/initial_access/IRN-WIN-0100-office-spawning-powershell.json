{
  "id": "IRN-WIN-0100",
  "name": "Office Spawning PowerShell",
  "description": "Office Spawning PowerShell (defensive detection).",
  "status": "stable",
  "severity": "high",
  "risk_score": 80,
  "platform": "windows",
  "event_types": [
    "process_create"
  ],
  "mitre": {
    "tactics": [
      "Initial Access"
    ],
    "techniques": [
      "T1566.001"
    ]
  },
  "logic": {
    "all": [
      {
        "field": "process_name",
        "op": "contains",
        "value": "powershell.exe"
      },
      {
        "field": "parent_process_name",
        "op": "contains",
        "value": "winword.exe"
      }
    ]
  },
  "author": "IronShield",
  "version": "1.0.0"
}
