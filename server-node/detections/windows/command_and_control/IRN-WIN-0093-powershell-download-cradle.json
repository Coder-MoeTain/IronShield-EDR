{
  "id": "IRN-WIN-0093",
  "name": "PowerShell Download Cradle",
  "description": "PowerShell Download Cradle (defensive detection).",
  "status": "stable",
  "severity": "high",
  "risk_score": 74,
  "platform": "windows",
  "event_types": [
    "process_create"
  ],
  "mitre": {
    "tactics": [
      "Command and Control"
    ],
    "techniques": [
      "T1105"
    ]
  },
  "logic": {
    "all": [
      {
        "field": "process_name",
        "op": "contains",
        "value": "powershell.exe"
      },
      {
        "field": "command_line",
        "op": "contains",
        "value": "DownloadString"
      }
    ]
  },
  "author": "IronShield",
  "version": "1.0.0"
}
